<?xml version="1.0" encoding="utf-8"?>
<!-- Nada do app vai para o backup na nuvem nem para outro aparelho (cookies, login dentro do app, fila e ajustes ficam só aqui) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <!-- Transferência de um celular para outro (no Android 12+ o allowBackup="false" não vale para ela) -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
